generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MERCHANT
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELED
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
  UNCOLLECTIBLE
  REFUNDED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

model User {
  id         String    @id @default(cuid())
  email      String    @unique
  password   String
  role       Role      @default(MERCHANT)
  merchantId String?   @unique
  merchant   Merchant? @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
}

model Merchant {
  id                         String   @id @default(cuid())
  slug                       String   @unique
  name                       String
  logoUrl                    String?
  googleReviewUrl            String?
  whatsappNumber             String?
  contactEmail               String?
  primaryColor               String   @default("#14141c")
  accentColor                String   @default("#c9a15a")
  active                     Boolean  @default(true)
  keepPublicPageWhenInactive Boolean  @default(true)
  merchantCanEditName        Boolean  @default(false)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  user         User?
  cards        NfcCard[]
  scans        ScanEvent[]
  reviews      Review[]
  clicks       GoogleClickEvent[]
  subscription Subscription?
  invoices     Invoice[]
  payments     Payment[]
}

model Subscription {
  id                   String             @id @default(cuid())
  merchantId           String             @unique
  merchant             Merchant           @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  plan                 String             @default("starter")
  status               SubscriptionStatus @default(TRIAL)
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  stripePriceId        String?
  startsAt             DateTime           @default(now())
  endsAt               DateTime?
  trialEndsAt          DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
}

model Invoice {
  id              String        @id @default(cuid())
  merchantId      String
  merchant        Merchant      @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  stripeInvoiceId String?       @unique
  number          String?       @unique
  status          InvoiceStatus @default(DRAFT)
  currency        String        @default("EUR")
  subtotalCents   Int           @default(0)
  vatCents        Int           @default(0)
  totalCents      Int           @default(0)
  peppolStatus    String?
  peppolMessageId String?
  issuedAt        DateTime      @default(now())
  dueAt           DateTime?
  paidAt          DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  payments Payment[]

  @@index([merchantId, issuedAt])
}

model Payment {
  id                    String        @id @default(cuid())
  merchantId            String
  merchant              Merchant      @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  invoiceId             String?
  invoice               Invoice?      @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  stripePaymentIntentId String?       @unique
  stripeChargeId        String?       @unique
  status                PaymentStatus @default(PENDING)
  amountCents           Int           @default(0)
  feeCents              Int           @default(0)
  netCents              Int           @default(0)
  currency              String        @default("EUR")
  paidAt                DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([merchantId, createdAt])
}

model Expense {
  id          String   @id @default(cuid())
  supplier    String
  description String
  amountCents Int
  vatCents    Int      @default(0)
  currency    String   @default("EUR")
  expenseDate DateTime @default(now())
  receiptUrl  String?
  category    String   @default("other")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([expenseDate])
}

model NfcCard {
  id         String   @id @default(cuid())
  cardId     String   @unique
  label      String   @default("Carte NFC")
  merchantId String
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  scans   ScanEvent[]
  reviews Review[]

  @@index([merchantId])
}

model ScanEvent {
  id         String   @id @default(cuid())
  merchantId String
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  cardId     String
  card       NfcCard  @relation(fields: [cardId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([merchantId, createdAt])
  @@index([cardId, createdAt])
}

model Review {
  id               String   @id @default(cuid())
  merchantId       String
  merchant         Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  cardId           String?
  card             NfcCard? @relation(fields: [cardId], references: [id], onDelete: SetNull)
  rating           Int
  isPrivate        Boolean  @default(false)
  firstName        String?
  comment          String?
  phone            String?
  notifiedEmail    Boolean  @default(false)
  notifiedWhatsapp Boolean  @default(false)
  createdAt        DateTime @default(now())

  clicks GoogleClickEvent[]

  @@index([merchantId, createdAt])
}

model GoogleClickEvent {
  id         String   @id @default(cuid())
  merchantId String
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  reviewId   String?
  review     Review?  @relation(fields: [reviewId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())

  @@index([merchantId, createdAt])
}

model RateLimitBucket {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([windowStart])
}
